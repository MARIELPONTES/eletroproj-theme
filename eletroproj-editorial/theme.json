{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "marca", "name": "Cor da marca", "color": "#D33A2C" },
				{ "slug": "marca-clara", "name": "Marca clara", "color": "#FAE7E6" },
				{ "slug": "link", "name": "Link", "color": "#0B66C3" },
				{ "slug": "texto", "name": "Texto", "color": "#2B2F36" },
				{ "slug": "suave", "name": "Texto suave", "color": "#5F6670" },
				{ "slug": "fundo", "name": "Fundo", "color": "#FFFFFF" },
				{ "slug": "cinza", "name": "Cinza claro", "color": "#F5F5F5" },
				{ "slug": "azul-claro", "name": "Azul claro", "color": "#E6F3FB" },
				{ "slug": "verde-claro", "name": "Verde claro", "color": "#E7F7EE" },
				{ "slug": "lilas-claro", "name": "Lilás claro", "color": "#F3EAFB" },
				{ "slug": "escuro", "name": "Escuro", "color": "#12232B" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "texto",
					"name": "Literata (texto)",
					"fontFamily": "Literata, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/literata-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/literata-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"slug": "titulos",
					"name": "Bricolage Grotesque (títulos)",
					"fontFamily": "'Bricolage Grotesque', 'Segoe UI', system-ui, -apple-system, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/bricolage-grotesque-latin-700-normal.woff2" ]
						},
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/bricolage-grotesque-latin-800-normal.woff2" ]
						}
					]
				},
				{
					"slug": "codigo",
					"name": "JetBrains Mono (código)",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-latin-400-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "pequeno", "name": "Pequeno", "size": "0.875rem" },
				{ "slug": "normal", "name": "Normal", "size": "1.125rem" },
				{ "slug": "medio", "name": "Médio", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "grande", "name": "Grande", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "enorme", "name": "Enorme", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--fundo)",
			"text": "var(--wp--preset--color--texto)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--texto)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titulos)",
					"fontWeight": "800"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--link)" }
			}
		}
	}
}
